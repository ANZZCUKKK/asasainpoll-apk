    <application
        android:label="AsasainPoll"
        android:name=".engine.App"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        android:extractNativeLibs="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Main launcher activity -->
        <activity
            android:name=".view.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Welcome / splash activity -->
        <activity
            android:name=".view.main.WelcomeActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true"/>

        <!-- Update required activity -->
        <activity
            android:name=".view.update.UpdateRequiredActivity"
            android:exported="false"/>

        <!-- Daemon service: keep-alive engine di background (clone DaemonService) -->
        <service
            android:name=".engine.DaemonService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":daemon">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="pool_engine"/>
        </service>

        <!-- Inner daemon untuk restart otomatis saat service mati -->
        <service
            android:name=".engine.DaemonService$DaemonInnerService"
            android:exported="false"
            android:process=":daemon"/>

        <!-- SystemCall provider: clone SystemCallProvider dari original -->
        <provider
            android:name=".base.SystemCallProvider"
            android:authorities="${applicationId}.system_call"
            android:exported="false"
            android:directBootAware="true"/>

        <!-- FileProvider untuk share file internal -->
        <provider
            android:name=".base.FileProvider"
            android:authorities="${applicationId}.file_provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths"/>
        </provider>

